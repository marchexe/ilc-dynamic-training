# Local Python environments and caches
.venv/
.venv-*/
.python/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

.agents/
.codex/
.claude/

# Heavy training outputs and model artifacts
*.auto.yaml
*.log
*.onnx
*.pt
*.root

# Runtime launch records live outside runs/ and remain local.
logs/

# Preserved preparation inputs are versionable; generated reviews/plots stay local.
configs/prepared/**/analysis/
configs/prepared/**/phase1_review/
configs/prepared/**/smoke/

# Keep lightweight research summaries in Git, but ignore generated result bulk
results/**
!results/
!results/research/
!results/research/README.md
!results/research/.gitkeep
!results/research/*.json
!results/research/*.csv

# Keep dataset provenance/manifests in Git, but not local parquet data
datasets/**
!datasets/
!datasets/README.md
!datasets/manifests/
!datasets/manifests/*.json

# Keep the small canonical pretrained bundle in Git
checkpoints/**
!checkpoints/pretrained/
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/source.txt
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/base_config.yaml
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/data_config.auto.yaml
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/metadata.json
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/net_best_epoch_state.pt
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/net_epoch-17_state.pt
!checkpoints/pretrained/ilc_nnqq_sgvnew_3cat_cut/net_epoch-17_optimizer.pt

runs/*
!runs/archive/
runs/archive/*
!runs/archive/showcases/
!runs/archive/showcases/**/
!runs/archive/showcases/**/*.csv
!runs/archive/showcases/**/*.json
!runs/archive/showcases/**/*.jsonl
!runs/archive/showcases/**/*.md
!runs/archive/showcases/**/*.png
!runs/archive/showcases/**/*.yaml

# Curated publication metadata/plots are versioned; model binaries are release assets.
published/experiments/**/models/
